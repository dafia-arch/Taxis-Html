      <div class="space-y-2">
        ${grupo.rutas.map((ruta, index) => `
          <div class="rounded-xl border border-slate-200 bg-white p-2">
            <p class="mb-2 text-xs font-bold uppercase tracking-wide text-slate-500">Ruta ${index + 1} (${ruta.length} personas)</p>
